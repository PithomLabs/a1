# =============================================================================
# WorkforceOps Lab — example environment. Copy to .env and adjust:
#   cp .env.example .env
# NEVER commit .env. NEVER put production credentials here.
# =============================================================================

# --- Local PostgreSQL (docker compose) ---
POSTGRES_DB=a1
POSTGRES_USER=a1
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
# Dev-only password for the six least-privilege roles (localhost only).
A1_DEV_ROLE_PASSWORD=a1-dev-local-only

# --- Application ---
# Runtime connection: the app role. serve, normal CLI commands and seed
# operations refuse superuser and migration_admin connections, so this
# must never point at POSTGRES_USER.
DATABASE_URL=postgresql://app:a1-dev-local-only@localhost:5432/a1
# Migration connection: the migration_admin role. `migrate up` and
# `migrate status` fail loudly on any other role.
MIGRATION_DATABASE_URL=postgresql://migration_admin:a1-dev-local-only@localhost:5432/a1
A1_ENV=dev
A1_LOG_FORMAT=json
A1_LOG_LEVEL=info
# Required from Phase 4 (local auth provider). Generate: openssl rand -hex 32
A1_JWT_SECRET=
A1_SHIFTHUB_PORT=8081
A1_PAYLOOP_PORT=8082

# --- LLM (optional until Phase 4; mock provider is the default) ---
OPENROUTER_API_KEY=
LLM_MODEL=openrouter/free

# --- Test database (DB-gated tests skip when unset) ---
# The test harness provisions its own roles and per-suite databases from
# this superuser maintenance connection; suites themselves connect as app.
WORKFORCEOPS_TEST_DATABASE_URL=postgresql://a1:change-me@localhost:5432/a1_test
